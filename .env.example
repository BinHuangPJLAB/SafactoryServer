SAFACTORY_HOST=0.0.0.0
SAFACTORY_PORT=8000
SAFACTORY_RETRY_AFTER_SECONDS=1
SAFACTORY_LOG_LEVEL=INFO
# SAFACTORY_AUTH_CONFIG_PATH=/absolute/path/to/trusted_api_keys.yaml

# 服务统一从 YAML 读取 image、DB、RJob、env、results 和启动参数。
# SAFACTORY_INITIALIZATION_CONFIG_PATH=/app/examples/real/initialization.yaml
# SAFACTORY_AUTH_CONFIG_PATH=/etc/safactory/trusted_api_keys.yaml

# initialization.yaml 中 ${VAR} 引用的 Secret/共享盘值：
# RJOB_ACCESS_KEY=
# RJOB_SECRET_KEY=
# WT_SDK_DB_URI=s3://bucket/database
# WT_SDK_ENV_CONFIG_DB_URI=s3://bucket/environment-config
# WT_SDK_S3_ENDPOINT=https://s3.example
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=cn-shanghai
# AWS_DEFAULT_REGION=cn-shanghai
# SAFACTORY_ENV_RJOB_SOURCE=gpfs://gpfs1/team/SafactoryServer/runtime/env
# SAFACTORY_RESULTS_RJOB_SOURCE=gpfs://gpfs1/team/SafactoryServer/runtime/results
# GATEWAY_MODEL_BASE_URL=https://model-service.example/v1
# GATEWAY_MODEL_API_KEY=
