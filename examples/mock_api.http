@base_url = http://127.0.0.1:8000
@api_key = safactory-local-development-key
@job_id = replace_after_create
@session_id = replace_after_list_sessions
@step_id = replace_after_list_steps

### 1. 查询模型
GET {{base_url}}/v1/models
Authorization: Bearer {{api_key}}

### 2. 创建 Job
POST {{base_url}}/v1/jobs
Content-Type: application/json
Authorization: Bearer {{api_key}}

{
  "model_id": "model_glm_001",
  "range_id": "range_web_001"
}

### 3. 查询 Session；刚创建时可能为空
GET {{base_url}}/v1/jobs/sessions?job_id={{job_id}}
Authorization: Bearer {{api_key}}

### 4. 查询结果；完成前 score 为 null
GET {{base_url}}/v1/sessions/result?job_id={{job_id}}&session_id={{session_id}}
Authorization: Bearer {{api_key}}

### 5. 查询 Step
GET {{base_url}}/v1/sessions/steps?job_id={{job_id}}&session_id={{session_id}}
Authorization: Bearer {{api_key}}

### 6. 查询轨迹
GET {{base_url}}/v1/sessions/steps/trajectory?job_id={{job_id}}&session_id={{session_id}}&step_id={{step_id}}
Authorization: Bearer {{api_key}}
